e/bc219a6d-e917-4e10-8dda-784ad4810abe/download/capag-municipios-posicao-2026-set.xlsx", "webstore_url": null, "last_modified": "2026-09-15T21:37:20.911087", "position": 16, "revision_id": "1610c6f6-38b9-410e-b42b-b3ee22ef1306", "resource_type": null}], "num_resources": 17, "tags": [{"vocabulary_id": null, "state": "active", "display_name": "Ajuste Fiscal de Estados DF e Munic\u00edpios", "id": "7d673f7b-e530-4538-baa2-b80dc86d2695", "name": "Ajuste Fiscal de Estados DF e Munic\u00edpios"}, {"vocabulary_id": null, "state": "active", "display_name": "Ajuste Fiscal de Estados e Municipios", "id": "00bc4c11-d846-4ec0-abb0-1b9f33a6306a", "name": "Ajuste Fiscal de Estados e Municipios"}, {"vocabulary_id": null, "state": "active", "display_name": "CAPAG", "id": "5aafe30a-85b4-4f54-bfc9-57f6466e9995", "name": "CAPAG"}, {"vocabulary_id": null, "state": "active", "display_name": "Estados e Municipios", "id": "9423ccf6-72a7-41e2-8405-288b5c417d73", "name": "Estados e Municipios"}, {"vocabulary_id": null, "state": "active", "display_name": "Estados e Munic\u00edpios", "id": "07d6a017-cd10-497c-a8b3-5641aec28d8c", "name": "Estados e Munic\u00edpios"}], "groups": [], "license_id": "odc-odbl", "relationships_as_subject": [], "organization": {"description": "", "created": "2015-11-13T17:13:24.242314", "title": "COREM", "name": "corem", "is_organization": true, "state": "active", "image_url": "", "revision_id": "77a33eaf-485e-4532-b0c6-f24ebf328d97", "type": "organization", "id": "03a4e0be-651a-4a34-9a2f-91b107c70e86", "approval_status": "approved"}, "name": "capag-municipios", "isopen": true, "url": "", "notes": "Este conjunto de dados cont\u00e9m as notas de capacidade de pagamento (CAPAG) de todos os munic\u00edpios, al\u00e9m das notas obtidas por eles em cada um dos tr\u00eas indicadores avaliados.\r\n\r\n*O resultado apurado para a CAPAG n\u00e3o vincula a posi\u00e7\u00e3o do Tesouro Nacional. O c\u00e1lculo definitivo da CAPAG ser\u00e1 efetuado por ocasi\u00e3o da verifica\u00e7\u00e3o do cumprimento dos limites e condi\u00e7\u00f5es para contrata\u00e7\u00e3o de opera\u00e7\u00f5es de cr\u00e9dito com garantia da Uni\u00e3o.*\r\n\r\nAs informa\u00e7\u00f5es do arquivo est\u00e3o alinhadas com o c\u00e1lculo apresentado na Pr\u00e9via Fiscal. Contudo, ao contr\u00e1rio do dado que \u00e9 apresentado l\u00e1, atualizado diariamente com base no dados homologados no siconfi at\u00e9 o dia anterior, a nota calculada aqui tem por base os dados do Siconfi dispon\u00edveis na data de gera\u00e7\u00e3o do arquivo.", "owner_org": "03a4e0be-651a-4a34-9a2f-91b107c70e86", "extras": [{"key": "Categoria do e-VoG", "value": "Economia e Finan\u00e7as"}, {"key": "Data de in\u00edcio dos dados", "value": "2018"}, {"key": "Frequ\u00eancia de atualiza\u00e7\u00e3o", "value": "Quadrimestral"}, {"key": "resource_group", "value": ""}], "license_url": "http://www.opendefinition.org/licenses/odc-odbl", "title": "Capacidade de Pagamento de Munic\u00edpios", "revision_id": "98290754-be2d-4c67-9171-900239f24206"}, {"license_title": "Licen\u00e7a Aberta para Bases de Dados (ODbL) do Open Data Commons", "maintainer": "", "relationships_as_object": [], "private": false, "maintainer_email": "", "num_tags": 4, "id": "f04a675e-4e5a-4e88-98de-acc3e22bf778", "metadata_created": "2018-11-28T17:54:26.602999", "metadata_modified": "2026-03-10T14:18:48.085144", "author": "COREM", "author_email": "", "state": "active", "version": "", "creator_user_id": "452b879b-c66a-4179-8f40-13f3f594b5c7", "type": "dataset", "resources": [{"resource_group": "Capag Exercicios Anteriores", "cache_last_updated": null, "package_id": "f04a675e-4e5a-4e88-98de-acc3e22bf778", "webstore_last_updated": null, "id": "ca03d8f8-c34e-44e8-a7b2-e914163741d4", "size": "876", "state": "active", "hash": "", "description": "Capag dos Estados ano base 2017", "format": "CSV", "mimetype_inner": null, "url_type": "upload", "mimetype": null, "cache_url": null, "name": "Capag Estados 2018", "created": "2022-11-08T